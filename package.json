{
  "name": "react-spa-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run routes && tsc -b && vite build",
    "preview": "vite preview",
    "routes": "tsr generate",
    "typecheck": "npm run routes && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "lefthook install",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.6",
    "@lwojcik/eslint-config": "0.3.1",
    "@playwright/test": "^1.65.1",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.4",
    "msw": "^3.0.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "license": "MIT"
}
