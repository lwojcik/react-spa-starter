# Copy to .env.local and adjust. See src/config/environment.ts for the schema.
# Only .env.example, .env.development, .env.e2e and .env.test are committed.
# Everything else (.env, .env.production, .env.local, .env.*.local) is git-ignored.
# Production builds read these variables from the host/CI environment.
VITE_APP_TITLE=React SPA Starter
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCKS=true
